# Copy this file to secret.yaml (gitignored), fill in real values, then
# `kubectl apply -f k8s/secret.yaml`. Never commit the filled-in version.
apiVersion: v1
kind: Secret
metadata:
  name: ai-pr-reviewer-secrets
type: Opaque
stringData:
  GITHUB_WEBHOOK_SECRET: ""
  GITHUB_API_TOKEN: ""
  DB_PASSWORD: ""
  AZURE_SERVICEBUS_CONNECTION_STRING: ""
  AZURE_OPENAI_ENDPOINT: ""
  AZURE_OPENAI_DEPLOYMENT: ""
  AZURE_OPENAI_API_KEY: ""
