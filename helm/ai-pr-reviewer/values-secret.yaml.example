# Copy to values-secret.yaml (gitignored) and fill in real values, then:
#   helm install ai-pr-reviewer helm/ai-pr-reviewer -f values-secret.yaml
# Alternatively, pass individual values via --set, e.g.:
#   --set secrets.githubApiToken=ghp_xxx
secrets:
  githubWebhookSecret: ""
  githubApiToken: ""
  dbPassword: ""
  azureServicebusConnectionString: ""
  azureOpenaiEndpoint: ""
  azureOpenaiDeployment: ""
  azureOpenaiApiKey: ""
